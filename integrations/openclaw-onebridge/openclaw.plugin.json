{
  "id": "onebridge",
  "name": "OneBridge",
  "description": "Use the OneBridge production control plane for durable AI artifact workflows.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "baseUrl"
    ],
    "properties": {
      "baseUrl": {
        "type": "string",
        "description": "OneBridge control-plane base URL."
      },
      "apiKey": {
        "type": "string",
        "description": "Optional OneBridge bearer API key."
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "onebridge_submit",
      "onebridge_status",
      "onebridge_artifacts",
      "onebridge_approve",
      "onebridge_retry",
      "onebridge_cancel"
    ]
  }
}
